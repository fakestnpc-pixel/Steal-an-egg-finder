local EGG_VALUES = {
    ["Golden Dragon Egg"]   = 1000,
    ["Mythic Phoenix Egg"]  = 750,
    ["Celestial Star Egg"]  = 500,
    ["Void Demon Egg"]      = 300,
    ["Crystal Egg"]         = 100,
    ["Common Egg"]          = 5
}
