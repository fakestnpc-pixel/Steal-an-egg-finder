-- 2. CORE LOGIC: FETCH, EVALUATE, AND TELEPORT
local function executeSniperScan()
    statusLabel.Text = "Status: Requesting server list from app.py..."
    
    -- Request the server list from your backend
    local success, response = pcall(function()
        return HttpService:GetAsync(BACKEND_URL)
    end)

    if not success or not response then
        statusLabel.Text = "Error: Failed to reach backend API."
        return
    end

    -- Parse the JSON response returned by Python
    local decodeSuccess, serverList = pcall(function()
        return HttpService:JSONDecode(response)
    end)

    if not decodeSuccess or type(serverList) ~= "table" then
        statusLabel.Text = "Error: Invalid JSON data received."
        return
    end

    statusLabel.Text = string.format("Scanned %d servers. Finding best match...", #serverList)

    -- Evaluate every server using our value dictionary
    local bestServer = nil
    local highestValueFound = 0

    for _, server in ipairs(serverList) do
        local eggName = server.currentEgg
        local eggValue = EGG_VALUES[eggName] or 0
        
        -- Check if this server's egg beats our current record
        if eggValue > highestValueFound then
            highestValueFound = eggValue
            bestServer = server
        end
    end

    -- Take action based on the findings
    if bestServer and highestValueFound >= MIN_VALUE_THRESHOLD then
        statusLabel.Text = string.format("Found: %s (Val: %d). Teleporting...", bestServer.currentEgg, highestValueFound)
        
        task.wait(0.5) -- Short pause so UI updates text before teleporting
        
        TeleportService:TeleportToPlaceInstance(
            game.PlaceId, 
            bestServer.jobId, 
            Player
        )
    else
        statusLabel.Text = "Status: No servers met value threshold."
    end
end

-- 3. CONNECT THE UI BUTTON TO THE SCRIPT LOGIC
searchButton.MouseButton1Click:Connect(executeSniperScan)
